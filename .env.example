# Copia este archivo como ".env" en local (nunca lo subas a git),
# y en Vercel añade estas mismas claves en:
# Project Settings → Environment Variables

# Servidor SMTP para enviar el email del pedido.
# Si usas Gmail: NO uses tu contraseña normal, genera una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion

# Email donde SORYNX quiere recibir los pedidos de prueba
ADMIN_EMAIL=ssorynx@gmail.com
